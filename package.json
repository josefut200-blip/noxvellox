{
  "name": "noxvellox",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler pages dev public --d1=DB",
    "deploy": "wrangler pages deploy public --project-name noxvellox --branch main",
    "db:local": "wrangler d1 execute noxvellox-db --local --file=./migrations/0001_schema.sql",
    "db:remote": "wrangler d1 execute noxvellox-db --remote --file=./migrations/0001_schema.sql",
    "deploy:cron": "wrangler deploy --config importer/wrangler.jsonc",
    "deploy:official-sync": "wrangler deploy --config official-sync/wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.59.0"
  }
}
