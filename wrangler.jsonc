{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noxvellox",
  "compatibility_date": "2026-11-20",
  "pages_build_output_dir": "./public",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noxvellox-db",
      "database_id": "d02dd003-9ab0-4cca-9623-1bcc4d940376"
    }
  ],
  "vars": {
    "ALLOWED_EMBED_HOSTS": "adultembed.com,iframe.videodelivery.net,www.pornhub.com",
    "ALLOWED_FEED_HOSTS": "adultembed.com",
    "VIDEO_FEED_URL": "https://adultembed.com/api/v1/search?studios=brazzers,teamskeet,reality-kings,naughty-america,bangbros,vixen,blacked,tushy,mofos,digital-playground,evil-angel,pure-taboo&per_page=100&sort=most_viewed&quality=hd&published_after=2020-01-01&min_duration=300&format=json",
    "OFFICIAL_FEED_STUDIOS": "Brazzers,TeamSkeet,Reality Kings,Naughty America,BangBros,Vixen,Blacked,Tushy,Mofos,Digital Playground,Evil Angel,Pure Taboo",
    "OFFICIAL_FEED_SORTS": "most_viewed,top_rated,newest",
    "OFFICIAL_FEED_MIN_PUBLISH_DATE": "2020-01-01",
    "OFFICIAL_FEED_MIN_DURATION_SECONDS": "300",
    "OFFICIAL_FEED_MAX_ENTRIES": "1000",
    "AUTO_PUBLISH_BRAZZERS": "verified-only",
    "CONTACT_EMAIL": "contato@noxvellox.site"
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "noxvellox-preview-db",
          "database_id": "37221c6d-f4a6-48fe-8c99-eb9df25ccbcd"
        }
      ]
    }
  }
}
